# Copy to .env and fill in. The real .env is gitignored.

# --- Qdrant vector database (memory / "seen before?") -----------------------
# Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333
# Local (docker compose): http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- Audit log (optional Postgres backend; SQLite is the default) -----------
POSTGRES_USER=energymind
POSTGRES_PASSWORD=energymind
POSTGRES_DB=energymind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_DSN=postgresql://energymind:energymind@localhost:5432/energymind

# --- Local LLM agents (default backend: ollama) -----------------------------
OLLAMA_HOST=http://localhost:11434

# --- OpenAI-compatible backend (vLLM/SGLang locally, or a cloud provider) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
